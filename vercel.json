{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://ritmo-77.firebaseapp.com/__/auth/:path*"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
