# ==============================================
# ritmo: configuração
# ==============================================
# Copie para .env (no computador) e cadastre as mesmas variáveis na Vercel
# (Settings → Environment Variables). Todas com VITE_ vão para o navegador:
# são públicas por design, identificam o projeto, não autorizam nada.

# Firebase (Console → Configurações do projeto → Seus apps → Web).
VITE_FIREBASE_API_KEY=
# No celular o login é por redirect. Use aqui o domínio do ritmo na Vercel
# (ex.: ritmo-tau-inky.vercel.app), não o firebaseapp.com. O vercel.json
# encaminha /__/auth para o Firebase.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# IA (Firebase AI Logic + Gemini Developer API, funciona no plano grátis).
# Opcional: sem ela, usa gemini-3.5-flash-lite com gemini-3.5-flash de reserva.
VITE_GEMINI_MODEL=gemini-3.5-flash-lite

# App Check (a IA exige): a chave de site do reCAPTCHA registrada no
# App Check como Fraud Defense. O reCAPTCHA v3 clássico foi descontinuado.
VITE_RECAPTCHA_ENTERPRISE_KEY=

# Strava (só no servidor, sem VITE_): crie o app em strava.com/settings/api
# com o domínio da Vercel em "Authorization Callback Domain".
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Lembretes por notificação (só no servidor, sem VITE_). O JSON inteiro da
# conta de serviço: Firebase → Configurações do projeto → Contas de serviço →
# Gerar nova chave privada. Cole o conteúdo do arquivo, do { ao }.
FIREBASE_SERVICE_ACCOUNT=
# Opcional: se definir, coloque o mesmo valor no segredo CRON_SECRET do
# GitHub (Settings → Secrets and variables → Actions).
CRON_SECRET=
