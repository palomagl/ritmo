# ==============================================
# Pulso: configuração
# ==============================================
# Copie para .env (no computador) e cadastre as mesmas variáveis na Vercel
# (Settings → Environment Variables). Todas com VITE_ vão para o navegador:
# são públicas por design, identificam o projeto, não autorizam nada.

# Firebase (Console → Configurações do projeto → Seus apps → Web).
# Dá para usar o MESMO projeto do Minha Rotina: o Pulso grava em coleções
# próprias (pulsoDias, pulsoRefeicoes...) e nada colide.
VITE_FIREBASE_API_KEY=
# No celular o login é por redirect. Use aqui o domínio do Pulso na Vercel
# (ex.: pulso-paloma.vercel.app), não o firebaseapp.com. O vercel.json
# encaminha /__/auth para o Firebase.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# IA (Firebase AI Logic + Gemini Developer API, plano grátis Spark).
# Troque o modelo aqui quando o Google lançar um novo; não precisa mexer no código.
VITE_GEMINI_MODEL=gemini-3.5-flash

# App Check: obrigatório para usar a IA a partir de 2 de novembro de 2026.
# Preencha UMA das duas (reCAPTCHA v3 é grátis e não pede cartão).
VITE_RECAPTCHA_V3_KEY=
VITE_RECAPTCHA_ENTERPRISE_KEY=
